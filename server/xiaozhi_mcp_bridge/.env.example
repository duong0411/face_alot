# Xiaozhi MCP WebSocket endpoint (lấy từ xiaozhi.me → Agent → MCP)
XIAOZHI_URL=wss://api.xiaozhi.me/mcp/?token=YOUR_JWT_HERE

# MQTT broker (cùng broker firmware SmartHome_ESP32)
MQTT_URL=wss://mqtt.duynguyen.io.vn/mqtt

# Chip ID trong firmware (#define CHIP_ID "esp32")
CHIP_ID=esp32

# Health HTTP (optional)
PORT=8790
